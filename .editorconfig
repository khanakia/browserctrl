# https://editorconfig.org — consistent whitespace across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt is the authority for Go; these just match it.
[*.go]
indent_style = tab
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,toml}]
indent_style = space
indent_size = 2

[Taskfile.yml]
indent_style = space
indent_size = 2
